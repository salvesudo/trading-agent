# ============================================================
# COPY TO .env AND FILL IN. NEVER COMMIT THE REAL .env FILE.
# ============================================================

# --- Mode switches -------------------------------------------------
TRADING_MODE=PAPER          # PAPER | LIVE  -- must stay PAPER until owner
                             # explicitly changes this after acceptance gates
STOP_TRADING=false          # emergency kill switch, see app/risk/kill_switch.py

# --- FYERS API v3 ----------------------------------------------------
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=
FYERS_STATIC_IP=            # the IP registered/whitelisted with FYERS
FYERS_ACCESS_TOKEN=         # written by `python -m app.broker.auth`, do not
                             # hand-type; expires daily, re-run each morning

# --- Capital & risk ----------------------------------------------------
INITIAL_CAPITAL_INR=5000
PROTECTED_CAPITAL_INR=5000
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=2.0
CONSECUTIVE_LOSS_SOFT_LIMIT=3
CONSECUTIVE_LOSS_HARD_LIMIT=5

# --- Database ----------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/fyers_agent
REDIS_URL=redis://localhost:6379/0

# --- Notifications (owner supplies later; do not hardcode) -------------
OWNER_EMAIL=
OWNER_MOBILE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
WHATSAPP_API_KEY=

# --- AI model (advisory layer only; risk engine has final authority) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Ops -----------------------------------------------------------------
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
