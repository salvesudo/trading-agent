# ============================================================
# COPY TO .env AND FILL IN. NEVER COMMIT THE REAL .env FILE.
#
# Every value below is on its own clean "KEY=value" line with NO trailing
# inline comment. Do not add one, even for a blank value -- pydantic-settings'
# .env parser only strips a trailing "# comment" when a real value already
# precedes it; on a blank value, the whole comment gets read as the literal
# value instead (this bit us once already -- see git history / README).
# ============================================================

# --- Mode switches -------------------------------------------------
# PAPER | LIVE -- must stay PAPER until owner explicitly changes this
# after acceptance gates (see docs/ACCEPTANCE_CRITERIA.md).
TRADING_MODE=PAPER
# Emergency kill switch. true blocks all new positions unconditionally.
STOP_TRADING=false

# --- FYERS API v3 ----------------------------------------------------
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=
# The IP registered/whitelisted with FYERS for this app.
FYERS_STATIC_IP=
# Written by `python -m app.broker.auth` (or callback_server.py) --
# do not hand-type. Expires daily; re-run that command each morning.
FYERS_ACCESS_TOKEN=

# --- Compliance (Phase 3) -----------------------------------------------
# Code cannot verify SEBI algo-trading registration or FYERS API
# permissions itself -- confirm directly with FYERS/exchange what current
# rules require for this account, then set this deliberately.
# See app/security/compliance.py.
OWNER_CONFIRMED_ALGO_PERMISSIONS=false

# --- Capital & risk ----------------------------------------------------
INITIAL_CAPITAL_INR=5000
PROTECTED_CAPITAL_INR=5000
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=2.0
CONSECUTIVE_LOSS_SOFT_LIMIT=3
CONSECUTIVE_LOSS_HARD_LIMIT=5
# Percent of every winning trade's profit swept into an untouchable
# reserve (app/risk/capital_ledger.py) that is never risked again.
PROFIT_RESERVE_PCT=20.0

# --- Database ----------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/fyers_agent
REDIS_URL=redis://localhost:6379/0

# --- Notifications (owner supplies later; do not hardcode) -------------
OWNER_EMAIL=
OWNER_MOBILE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
WHATSAPP_API_KEY=

# --- AI model (advisory layer only; risk engine has final authority) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Ops -----------------------------------------------------------------
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
